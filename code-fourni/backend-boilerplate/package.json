{
  "name": "backend-boilerplate",
  "version": "1.0.0",
  "description": "Boilerplate backend des évaluations du cours BINV2150-A",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx --env-file=env/dev.env --watch src/main.ts",
    "build": "tsc -p .",
    "start": "node --env-file=env/dev.env dist/main.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
